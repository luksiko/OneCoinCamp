{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "camper-monitor",
  "main": "src/index.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhook*", "/health", "/run", "/check"]
  },
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camper_monitor_db",
      "database_id": "f0e8c048-9f3c-4fcb-89d8-5228d47e69d5"
    }
  ],
  "vars": {
    "TELEGRAM_CHAT_ID": "369796958",
    "ALERTS_ENABLED": "true",
    "WEBHOOK_CUTOVER": "true",
    "WORKER_PUBLIC_URL": "https://camper-monitor.luksiko90.workers.dev",
    "GAS_PROXY_URL": "https://script.google.com/macros/s/AKfycbxYkBcGj8-TMe_4TocnDgUCdh8I3AKqayAZwve-dgt21R6U6UQxa24lF5eQUvHUKn9FNw/exec"
  },
  "secrets": {
    "required": ["TELEGRAM_BOT_TOKEN_SECRET", "TELEGRAM_WEBHOOK_SECRET"]
  }
}
